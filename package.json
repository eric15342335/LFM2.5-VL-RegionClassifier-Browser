{
  "name": "lfm2-5-vl-region-classifier-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based WebGPU selected-region image classifier",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "prebuild": "node scripts/copy-readme-to-llms.mjs",
    "build": "vite build",
    "diff": "git diff --staged --function-context > commit.txt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate index.html",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint && pnpm run lint:css && pnpm run lint:html",
    "check": "pnpm run verify:manifest && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "metrics": "node scripts/measure-codebase.mjs",
    "verify:manifest": "node scripts/verify-model-manifest.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "~4.2.0",
    "@mantine/core": "~9.5.0",
    "@mantine/dropzone": "~9.5.0",
    "@mantine/hooks": "~9.5.0",
    "@mantine/notifications": "~9.5.0",
    "@xstate/react": "~6.1.0",
    "comlink": "~4.4.2",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-image-crop": "~11.1.2",
    "valibot": "~1.4.2",
    "xstate": "~5.32.5"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "~4.7.1",
    "@testing-library/react": "~16.3.2",
    "@testing-library/user-event": "~14.6.1",
    "@types/node": "~26.1.1",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "~6.0.4",
    "@webgpu/types": "~0.1.71",
    "eslint": "~10.8.0",
    "eslint-config-prettier": "~10.1.8",
    "globals": "~17.8.0",
    "html-validate": "~11.5.6",
    "jsdom": "~26.1.0",
    "oxlint": "~1.75.0",
    "prettier": "~3.9.6",
    "stylelint": "~17.14.1",
    "stylelint-config-standard": "~40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.65.0",
    "vite": "~8.1.5",
    "vitest": "~4.1.10"
  },
  "packageManager": "pnpm@11.17.0"
}
