{
  "name": "LFM2.5-VL-RegionClassifier-UI",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-only WebGPU selected-region image classifier",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate index.html",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint && pnpm run lint:css && pnpm run lint:html",
    "check": "pnpm run audit && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "audit": "node scripts/audit-browser-only.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "~4.2.0",
    "@ianvs/prettier-plugin-sort-imports": "~4.7.1"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/node": "~26.1.1",
    "@webgpu/types": "~0.1.71",
    "eslint": "~10.8.0",
    "eslint-config-prettier": "~10.1.8",
    "globals": "~17.7.0",
    "html-validate": "~11.5.6",
    "oxlint": "~1.75.0",
    "prettier": "~3.9.6",
    "stylelint": "~17.14.1",
    "stylelint-config-standard": "~40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.65.0",
    "vite": "~8.1.5",
    "vitest": "~4.1.10"
  }
}
